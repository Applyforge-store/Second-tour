# Neon: copy the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-value"

# Public URL after deployment, without a trailing slash.
APP_URL="http://localhost:3000"

# Gmail account used to send reminders. Use an app password, never the normal password.
GMAIL_USER="contact@example.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
FROM_NAME="Second Tour"

# Generate another random value. Vercel Cron sends it as a Bearer token.
CRON_SECRET="replace-with-another-long-random-value"

# Initial owner account. Used only by npm run db:migrate when there are no users.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-at-least-12-characters"
